{
  "name": "@trogonstack/claude-agent-sdk-nats",
  "version": "0.0.1",
  "description": "NATS JetStream-backed SessionStore adapter for the Claude Agent SDK",
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "jetstream",
    "nats",
    "session-store"
  ],
  "license": "MIT",
  "author": "Straw Hat, LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrogonStack/claude-agent-sdk-nats.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "demo": "bun run examples/demo.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@nats-io/transport-node": "^3.4.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220"
  }
}
